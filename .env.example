# GEMINI_API_KEY: Required for optional AI-assisted requirement & pricing suggestions.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Single authorized studio administrator email (verified server-side only).
ADMIN_EMAIL=

# TURNSTILE_SECRET_KEY: Optional Cloudflare Turnstile secret key for backend verification.
TURNSTILE_SECRET_KEY=

# VITE_TURNSTILE_SITE_KEY: Optional public Cloudflare Turnstile site key for forms.
VITE_TURNSTILE_SITE_KEY=
